+    /// Configure client-certificate verification on a server context.
+    ///
+    /// `SSL_VERIFY_PEER` makes the server send a CertificateRequest; adding
+    /// `SSL_VERIFY_FAIL_IF_NO_PEER_CERT` makes a missing client certificate a
+    /// fatal handshake error instead of an accepted unauthenticated session.
+    pub fn set_verify_client_cert(&mut self, require: bool) {
+        const SSL_VERIFY_PEER: i32 = 0x01;
+        const SSL_VERIFY_FAIL_IF_NO_PEER_CERT: i32 = 0x02;
+
+        let mode = SSL_VERIFY_PEER
+            | if require {
+                SSL_VERIFY_FAIL_IF_NO_PEER_CERT
+            } else {
+                0
+            };
+
+        unsafe {
+            SSL_CTX_set_verify(self.as_mut_ptr(), mode, ptr::null());
+        }
+    }
